# DeepSeek API（必填，用于 AI 总结 / 思维导图 / 问答）
# 获取: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# 可选覆盖
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_COMPLETE_TIMEOUT=120
# DEEPSEEK_HTTP_TIMEOUT=120

# 无字幕时语音转写（faster-whisper）：tiny 更快，base/small 更准
# WHISPER_MODEL=tiny
# 语种：留空或 auto=自动检测（推荐，可识别英文）；可强制 en / zh
# ASR_LANGUAGE=auto
# 单次转写最长秒数（默认 1800=30 分钟）；超过则只转写前 N 分钟
# 38 分钟视频若要全文转写，可设为 2700（45 分钟）或更大
# ASR_MAX_DURATION=1800
# HF_ENDPOINT=https://hf-mirror.com

# 绕过 B站 / 抖音等平台风控（生产用运维上传，勿在容器内用 FROM_BROWSER）
# Docker Compose 默认：COOKIES_FILE=/secrets/cookies.txt（挂载仓库根 secrets/）
# 本机非 Docker 可二选一：
# COOKIES_FROM_BROWSER=chrome
# COOKIES_FROM_BROWSER=safari
# COOKIES_FILE=/absolute/path/to/cookies.txt
#
# 上传到服务器：./scripts/upload-cookies.sh ./cookies.txt ubuntu@HOST
# 说明：docs/deploy-online-guide.md §14.2

# —— 用户体系 / JWT ——
# 生产环境务必换成足够长的随机字符串
JWT_SECRET=dev-change-me-to-a-long-random-string
# JWT_EXPIRE_HOURS=168
# DATABASE_PATH=./data/app.db

# —— Stripe（Test Mode）——
# 详见 docs/stripe-setup.md
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO=price_xxx
FRONTEND_URL=http://localhost:3000
