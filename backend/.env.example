# DeepSeek API（必填，用于 AI 总结 / 思维导图 / 问答）
# 获取: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# 可选覆盖
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# 无字幕时语音转写（faster-whisper）：tiny 更快，base/small 更准
# WHISPER_MODEL=tiny
# 语种：留空或 auto=自动检测（推荐，可识别英文）；可强制 en / zh
# ASR_LANGUAGE=auto
# 单次转写最长秒数（默认 1800=30 分钟）；超过则只转写前 N 分钟
# 38 分钟视频若要全文转写，可设为 2700（45 分钟）或更大
# ASR_MAX_DURATION=1800
# HF_ENDPOINT=https://hf-mirror.com

# 绕过 B站 / YouTube 反爬与地区限制（任选其一）
# COOKIES_FROM_BROWSER=chrome
# COOKIES_FROM_BROWSER=safari
# COOKIES_FILE=/absolute/path/to/cookies.txt
